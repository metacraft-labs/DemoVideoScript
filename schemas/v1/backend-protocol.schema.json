{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/metacraft-labs/DemoVideoScript/schemas/v1/backend-protocol.schema.json",
  "title": "DemoVideoScript backend protocol, version 1 (JSON lines)",
  "$comment": "A response answers the request with the same id: response-<call> (response-empty for stage, end-stage, send, shutdown) or response-error.",
  "$defs": {
    "segment": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "role"
          ],
          "additionalProperties": false,
          "properties": {
            "role": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "keys": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "ordinal": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "focused"
          ],
          "additionalProperties": false,
          "properties": {
            "focused": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "required": [
            "ancestor"
          ],
          "additionalProperties": false,
          "properties": {
            "ancestor": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          }
        }
      ]
    },
    "locator": {
      "type": "object",
      "required": [
        "segments"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "parent": {
          "type": "string",
          "$comment": "resolve the segments among this instance's children"
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/segment"
          }
        }
      }
    },
    "geometry": {
      "type": "object",
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number"
        },
        "h": {
          "type": "number"
        },
        "visible": {
          "type": "boolean"
        }
      }
    },
    "response-error": {
      "type": "object",
      "required": [
        "id",
        "ok",
        "error"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "object",
          "required": [
            "kind",
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "unsupported",
                "refused",
                "not-found",
                "stage-closed",
                "stage",
                "protocol",
                "crashed",
                "internal"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    },
    "response-hello": {
      "type": "object",
      "required": [
        "id",
        "ok",
        "backend",
        "capabilities",
        "units"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer"
        },
        "ok": {
          "const": true
        },
        "backend": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "platform": {
          "enum": [
            "linux",
            "macos",
            "windows"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "input.key",
              "input.chord",
              "input.text",
              "input.pointer.move",
              "input.pointer.click",
              "input.pointer.drag",
              "input.wheel",
              "input.hover",
              "observe.text",
              "observe.geometry",
              "observe.style",
              "observe.image",
              "observe.focus",
              "sync.event",
              "sync.visual-settle",
              "record.cast",
              "record.video",
              "record.still",
              "record.mask"
            ]
          }
        },
        "bindings": {
          "type": [
            "object",
            "null"
          ]
        },
        "units": {
          "enum": [
            "cell",
            "px"
          ]
        }
      }
    },
    "response-locate": {
      "type": "object",
      "required": [
        "id",
        "ok",
        "outcome"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer"
        },
        "ok": {
          "const": true
        },
        "outcome": {
          "enum": [
            "one",
            "none",
            "ambiguous"
          ]
        },
        "instance": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "response-read": {
      "type": "object",
      "required": [
        "id",
        "ok",
        "values"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer"
        },
        "ok": {
          "const": true
        },
        "values": {
          "type": "object",
          "properties": {
            "geometry": {
              "$ref": "#/$defs/geometry"
            }
          }
        }
      }
    },
    "response-await": {
      "type": "object",
      "required": [
        "id",
        "ok",
        "met"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer"
        },
        "ok": {
          "const": true
        },
        "met": {
          "type": "boolean"
        }
      }
    },
    "response-resolve-chord": {
      "type": "object",
      "required": [
        "id",
        "ok",
        "chord"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer"
        },
        "ok": {
          "const": true
        },
        "chord": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "response-hit": {
      "type": "object",
      "required": [
        "id",
        "ok",
        "locator"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer"
        },
        "ok": {
          "const": true
        },
        "locator": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "response-record": {
      "type": "object",
      "required": [
        "id",
        "ok",
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer"
        },
        "ok": {
          "const": true
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "response-empty": {
      "type": "object",
      "required": [
        "id",
        "ok"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer"
        },
        "ok": {
          "const": true
        }
      }
    },
    "request": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "id",
            "call",
            "protocol"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "integer"
            },
            "call": {
              "const": "hello"
            },
            "protocol": {
              "const": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "call",
            "use",
            "with"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "integer"
            },
            "call": {
              "const": "stage"
            },
            "use": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "with": {
              "type": "object",
              "properties": {
                "$base": {
                  "type": "string"
                },
                "$env": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "$comment": "a deterministic run's environment substitutions, for the application the stage starts"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "call"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "integer"
            },
            "call": {
              "const": "end-stage"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "call",
            "operation"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "integer"
            },
            "call": {
              "const": "resolve-chord"
            },
            "operation": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "call",
            "locator"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "integer"
            },
            "call": {
              "const": "locate"
            },
            "locator": {
              "$ref": "#/$defs/locator"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "call",
            "instance",
            "properties"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "integer"
            },
            "call": {
              "const": "read"
            },
            "instance": {
              "type": "string"
            },
            "properties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "call",
            "action"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "integer"
            },
            "call": {
              "const": "send"
            },
            "action": {
              "type": "object",
              "$comment": "a normalised input step (scenario.schema.json) with 'targets' (instance ids for target/from/to/via) and, in realistic runs, 'timing' (keyDelaysMs; path and approach as [x, y, ms] points in the backend's units); or {ext, with}"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "call",
            "condition",
            "timeoutMs"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "integer"
            },
            "call": {
              "const": "await"
            },
            "condition": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$"
            },
            "instance": {
              "type": "string"
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "call",
            "op"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "integer"
            },
            "call": {
              "const": "record"
            },
            "op": {
              "enum": [
                "start",
                "mark",
                "still",
                "stop"
              ]
            },
            "dir": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "instance": {
              "type": "string"
            },
            "step": {
              "type": "integer"
            },
            "kind": {
              "type": "string"
            },
            "virtualMs": {
              "type": "number",
              "minimum": 0,
              "$comment": "mark: the step's start on the virtual timeline"
            },
            "deterministic": {
              "type": "boolean",
              "$comment": "start: a documentation capture; media carry no wall-clock time"
            },
            "mask": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "$comment": "still: instances whose region the still masks (declared volatile regions)"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "call",
            "x",
            "y"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "integer"
            },
            "call": {
              "const": "hit"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "call"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "integer"
            },
            "call": {
              "const": "shutdown"
            }
          }
        }
      ]
    },
    "response": {
      "anyOf": [
        {
          "$ref": "#/$defs/response-error"
        },
        {
          "$ref": "#/$defs/response-hello"
        },
        {
          "$ref": "#/$defs/response-locate"
        },
        {
          "$ref": "#/$defs/response-read"
        },
        {
          "$ref": "#/$defs/response-await"
        },
        {
          "$ref": "#/$defs/response-resolve-chord"
        },
        {
          "$ref": "#/$defs/response-hit"
        },
        {
          "$ref": "#/$defs/response-record"
        },
        {
          "$ref": "#/$defs/response-empty"
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ]
}
